# Medirator environment template
# Copy to .env and customize.

# Core
# For Fly.io with a mounted volume at /data:
#   APP_DATABASE_URL=sqlite:////data/app.db
APP_DATABASE_URL=sqlite:///./app.db
APP_TOKEN_PEPPER=replace-with-a-long-random-secret

# WebAuthn (must match your public domain exactly)
# RP ID is domain only (no scheme, no path, usually no port in production).
APP_WEBAUTHN_RP_ID=localhost
APP_WEBAUTHN_RP_NAME=Medirator
APP_WEBAUTHN_ORIGIN=http://localhost:8000

# Session
APP_SESSION_COOKIE_NAME=session_token
APP_SESSION_TTL_HOURS=336
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_COOKIE_SAMESITE=lax
# Leave blank to use host-only cookie.
APP_SESSION_COOKIE_DOMAIN=

# App
APP_CHALLENGE_TTL_MINUTES=10
APP_ENABLE_BUILTIN_UI=true
APP_CORS_ALLOW_ORIGINS=http://localhost:8000

# Dev only
# Keep false in production.
APP_INSECURE_DEV_WEBAUTHN=false
